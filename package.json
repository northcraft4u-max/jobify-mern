{
  "name": "jobify",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
 "scripts": {
    "setup-project": "npm install --include=dev && cd client && npm install --include=dev --legacy-peer-deps",
    "build-client": "cd client && npm run build",
    "setup-production": "npm run setup-project && npm run build-client",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "start": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.37.3",
    "concurrently": "^8.0.1",
    "cookie-parser": "^1.4.6",
    "datauri": "^4.1.0",
    "dayjs": "^1.11.7",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^6.0.2",
    "nodemon": "^3.1.11"
  }
}
